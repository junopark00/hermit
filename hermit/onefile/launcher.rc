// Icon and version information of the Hermit single-file exe.
#include <winver.h>

1 ICON "..\\..\\app\\hermit.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Hermit"
            VALUE "FileDescription", "Hermit"
            VALUE "FileVersion", "1.1.0"
            VALUE "ProductName", "Hermit"
            VALUE "ProductVersion", "1.1.0"
            VALUE "OriginalFilename", "Hermit.exe"
            VALUE "LegalCopyright", "Copyright 2026 Juno Park and the Moonlight contributors. GPL-3.0-or-later."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
